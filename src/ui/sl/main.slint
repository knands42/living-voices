import { LineEdit } from "std-widgets.slint";
import { AppTheme } from "theme.slint";

export struct AdventureSummary {
    id: string,
    title: string,
    description: string,
}

component NewDraftOverlay inherits Rectangle {
    callback submit(string, string);
    callback dismiss();

    background: AppTheme.scrim;

    // Dismiss when the scrim behind the card is clicked.
    TouchArea {
        clicked => { root.dismiss(); }
    }

    Rectangle {
        width: 440px;
        height: card-layout.preferred-height;
        background: AppTheme.bg-panel;
        border-radius: AppTheme.radius-card;
        border-width: 1px;
        border-color: AppTheme.bronze;

        // Swallow clicks so tapping the card does not dismiss the overlay.
        TouchArea {}

        card-layout := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: "New adventure";
                color: AppTheme.gold;
                font-family: AppTheme.font-brand;
                font-size: AppTheme.font-title;
            }

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Title";
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label;
                }

                title-field := LineEdit {
                    placeholder-text: "Name your adventure…";
                    font-family: AppTheme.font-body;
                }
            }

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Headline";
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label;
                }

                headline-field := LineEdit {
                    placeholder-text: "A one-line hook…";
                    font-family: AppTheme.font-body;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 12px;

                cancel-area := TouchArea {
                    width: cancel-label.preferred-width + 32px;
                    height: 36px;
                    clicked => { root.dismiss(); }

                    Rectangle {
                        background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.btn-brown;
                        border-radius: AppTheme.radius-pill;
                        border-width: 1px;
                        border-color: AppTheme.bronze;

                        cancel-label := Text {
                            text: "Cancel";
                            color: AppTheme.text-light;
                            font-family: AppTheme.font-body;
                        }
                    }
                }

                create-area := TouchArea {
                    property <bool> can-submit: title-field.text != "";
                    width: create-label.preferred-width + 32px;
                    height: 36px;
                    enabled: self.can-submit;
                    clicked => {
                        root.submit(title-field.text, headline-field.text);
                        title-field.text = "";
                        headline-field.text = "";
                        root.dismiss();
                    }

                    Rectangle {
                        background: !create-area.can-submit
                            ? AppTheme.btn-brown
                            : (parent.has-hover ? AppTheme.gold-bright : AppTheme.gold);
                        border-radius: AppTheme.radius-pill;

                        create-label := Text {
                            text: "Create";
                            color: create-area.can-submit ? AppTheme.text-ink : AppTheme.text-muted;
                            font-family: AppTheme.font-body;
                        }
                    }
                }
            }
        }
    }
}

export component MainPage inherits Rectangle {
    in property <[AdventureSummary]> adventures;
    callback adventure-selected(string);
    callback create-adventure(string, string);

    property <bool> show-draft: false;

    background: AppTheme.bg-deepest;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Choose your adventure";
            color: AppTheme.gold;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-title;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            new-draft-area := TouchArea {
                width: new-draft-label.preferred-width + 40px;
                height: 40px;
                clicked => { root.show-draft = true; }

                Rectangle {
                    background: parent.has-hover ? AppTheme.gold-bright : AppTheme.gold;
                    border-radius: AppTheme.radius-pill;

                    new-draft-label := Text {
                        text: "Create Adventure";
                        color: AppTheme.text-ink;
                        font-family: AppTheme.font-brand;
                        font-size: AppTheme.font-label;
                    }
                }
            }
        }

        if root.adventures.length == 0: Text {
            text: "No adventures yet.";
            color: AppTheme.text-muted;
            font-family: AppTheme.font-body;
            horizontal-alignment: center;
        }

        for adventure in root.adventures: TouchArea {
            height: 72px;
            clicked => { root.adventure-selected(adventure.id); }

            Rectangle {
                background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.bg-panel;
                border-radius: AppTheme.radius-card;
                border-width: 1px;
                border-color: AppTheme.bronze;

                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    Text {
                        text: adventure.title;
                        color: AppTheme.text-light;
                        font-family: AppTheme.font-display;
                        font-size: AppTheme.font-card-title;
                    }

                    Text {
                        text: adventure.description;
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Modal overlay: fills the whole page and sits above everything else.
    if root.show-draft: NewDraftOverlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        submit(title, headline) => { root.create-adventure(title, headline); }
        dismiss => { root.show-draft = false; }
    }
}
