import { AppTheme } from "theme.slint";
import { NavTab, TopBar } from "shared.slint";
import {
    HomePage,
    DustMotes,
    CandleVignette,
    ChipData,
    PresetData,
    AdventureCardData,
    CardCast,
} from "main.slint";
import {
    ChatPage,
    ChatCharacter,
    ChatMessage,
    ActionMode,
    NarratorEvent,
    StoryClockData,
} from "chat.slint";

// Re-export data types so Rust (slint::include_modules!) can build/send them.
export {
    NavTab,
    ChipData, PresetData, AdventureCardData, CardCast,
    ChatCharacter, ChatMessage, ActionMode,
    NarratorEvent, StoryClockData,
}

// ---------------------------------------------------------------------------
// Page identifiers. Keep in sync with Rust (0 = home, 1 = chat).
// ---------------------------------------------------------------------------

// 0 = Home (Adventures / Campaigns)
// 1 = Chat (active campaign)

export component RootWindow inherits Window {
    title: "Living Voices";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 640px;
    background: AppTheme.bg-deepest;
    default-font-family: AppTheme.font-body;
    default-font-size: 14px;
    default-font-weight: 400;

    // ---- Page state ----
    in-out property <int> page: 0;
    in-out property <int> active-tab: 0;

    // ---- Top bar ----
    in property <[NavTab]> nav-tabs: [
        { label: "Campaigns" },
        { label: "Character" },
        { label: "Lore" },
    ];

    // ---- Home-page inputs ----
    in property <string> player-name: "Kestrel";
    in-out property <bool> nsfw-enabled: false;
    in-out property <int> category: 0;
    in property <bool> show-nsfw: false;

    in property <[ChipData]> category-chips: [
        { label: "All" }, { label: "Fantasy" }, { label: "Mystery" },
        { label: "Horror" }, { label: "Romance" }, { label: "Intrigue" }
    ];
    in property <[PresetData]> presets: [
        { label: "Tavern Meeting" }, { label: "Dungeon Crawl" }, { label: "Court Intrigue" }
    ];
    in property <[[AdventureCardData]]> adventure-rows: [
        [
            {
                title: "The Ashen Spire",
                genre: "Fantasy",
                chapter-line: "Chapter 4 - Evening",
                progress: 0.42,
                active: true,
                ribbon: "Last visited: The Ashen Spire - Chapter 4",
                art: #4a2c1a,
                cast: [{ name: "Morwyn", glyph: "M", hue: #5a3a52 }, { name: "Tal", glyph: "T", hue: #3a4a52 }, { name: "Vex", glyph: "V", hue: #52452a }]
            },
            {
                title: "A Lantern in Rooksmoor",
                genre: "Mystery",
                chapter-line: "Chapter 1 - Night",
                progress: 0.11,
                active: false,
                ribbon: "",
                art: #1f2a33,
                cast: [{ name: "Iselle", glyph: "I", hue: #43352a }]
            },
            {
                title: "Hollow Reliquary",
                genre: "Horror",
                chapter-line: "Chapter 7 - Deep Night",
                progress: 0.78,
                active: false,
                ribbon: "",
                art: #26221f,
                cast: [{ name: "Brother Aum", hue: #2f3a33 }, { name: "Sable", glyph: "S", hue: #4a2f33 }]
            }
        ],
        [
            {
                title: "Court of Salt and Sigils",
                genre: "Intrigue",
                chapter-line: "Chapter 2 - Morning",
                progress: 0.24,
                active: false,
                ribbon: "",
                art: #33301f,
                cast: [{ name: "Duchess Rav", hue: #52452a }, { name: "Oren", glyph: "O", hue: #2f3a33 }]
            }
        ]
    ];

    // ---- Chat-page inputs ----
    in property <[ChatCharacter]> characters: [
        { name: "Kaelen", role: "Elf Ranger", glyph: "K", hue: #2f4a2a, active: false, location: "", level: "", status: "" },
        { name: "Zora",   role: "Wizard",    glyph: "Z", hue: #3a2f52, active: false, location: "", level: "", status: "" },
        { name: "Morwyn", role: "Rogue",     glyph: "M", hue: #3a2a1f, active: true,  location: "Alley", level: "Level 1", status: "Status" }
    ];
    in property <[ChatMessage]> messages: [
        { speaker: "Kaelen",   time: "14:32",      narrator: false, own: false, text: "The forest feels unusually quiet tonight..." },
        { speaker: "Zora",     time: "14:32",      narrator: false, own: false, text: "Indeed, the magical aura has shifted." },
        { speaker: "Narrator", time: "scroll bg.", narrator: true,  own: false, text: "You hear rustling in the bushes nearby..." },
        { speaker: "Morwyn",   time: "14:34",      narrator: false, own: true,  text: "I'll scout ahead carefully..." }
    ];
    in property <[ActionMode]> action-modes: [
        { label: "Say" }, { label: "Do" }, { label: "Think" }, { label: "Whisper" }
    ];
    in-out property <int> active-mode: 0;
    in-out property <ChatCharacter> whisper-target: {
        name: "Morwyn", role: "Rogue", glyph: "M", hue: #3a2a1f,
        active: false, location: "", level: "", status: ""
    };
    // Live draft text in the composer. Rust reads it on send and clears it after.
    in-out property <string> draft: "";
    in property <NarratorEvent> narrator-event: {
        body: "A guard rounds the corner, halting your progress!",
        event-label: "EVENT: A Guard Appears"
    };
    in property <StoryClockData> story-clock: { phase: "EVENING", time: "19:48" };

    // ---- Callbacks ----
    callback nav-tab-selected(int);
    // Home
    callback adventure-selected(string);
    callback new-adventure();
    callback preset-selected(string);
    callback category-selected(int);
    callback nsfw-toggled(bool);
    // Chat
    callback character-selected(string);
    callback mode-selected(int);
    callback send-message();

    // ---- Background atmosphere (shared across pages) ----
    DustMotes {}
    CandleVignette {}

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        TopBar {
            tabs: root.nav-tabs;
            active-index: root.active-tab;
            tab-selected(i) => {
                root.active-tab = i;
                root.nav-tab-selected(i);
            }
        }

        if root.page == 0: HomePage {
            player-name: root.player-name;
            nsfw-enabled: root.nsfw-enabled;
            category: root.category;
            show-nsfw: root.show-nsfw;
            category-chips: root.category-chips;
            presets: root.presets;
            adventure-rows: root.adventure-rows;
            adventure-selected(title) => { root.adventure-selected(title); }
            new-adventure => { root.new-adventure(); }
            preset-selected(label) => { root.preset-selected(label); }
            category-selected(i) => { root.category-selected(i); }
            nsfw-toggled(on) => {
                root.nsfw-enabled = on;
                root.nsfw-toggled(on);
            }
        }

        if root.page == 1: ChatPage {
            characters: root.characters;
            messages: root.messages;
            action-modes: root.action-modes;
            active-mode <=> root.active-mode;
            whisper-target <=> root.whisper-target;
            draft <=> root.draft;
            narrator-event: root.narrator-event;
            story-clock: root.story-clock;
            character-selected(name) => { root.character-selected(name); }
            mode-selected(i) => { root.mode-selected(i); }
            send-message => { root.send-message(); }
        }
    }
}
