import { AppTheme } from "theme.slint";
import { MainPage, MainGlobals, AdventureSummaryView } from "main.slint";
import { ChatPage, ChatGlobals } from "chat.slint";
import { BuilderPage, BuilderGlobals } from "builder/builder_page.slint";
import { CharacterPage, CharacterGlobals } from "character/character_page.slint";
import { NoticeToast, NoticeGlobals } from "popup/notice.slint";
import {
    AdventureView, ActView, StateView, FactView, MessageView, BuilderView,
    StoryInputView, ActInputView, CharacterView, CharacterCreationInput,
} from "views.slint";

// Rust reaches each page through its own global.
export { MainGlobals, ChatGlobals, BuilderGlobals, CharacterGlobals, NoticeGlobals }
export {
    AdventureSummaryView, AdventureView, ActView, StateView, FactView, MessageView, BuilderView,
    StoryInputView, ActInputView, CharacterView, CharacterCreationInput,
}

// Only decides which page is on screen. No page data and no page events live here.
export component RootWindow inherits Window {
    title: "Living Voices";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 640px;
    background: AppTheme.bg-deepest;
    default-font-family: AppTheme.font-body;
    default-font-size: 14px;
    default-font-weight: 400;

    // "main", "builder", "character" or "chat". Rust sets it after a page has loaded.
    in-out property <string> current-page: "main";

    if current-page == "main": MainPage { }

    if current-page == "builder": BuilderPage {
        back-requested => { root.current-page = "main"; }
    }

    if current-page == "character": CharacterPage {
        // Rust renders the builder from its cache and then switches the page, so the
        // cast reflects whatever the character page just saved.
        back-requested => { BuilderGlobals.builder-entered(); }
    }

    if current-page == "chat": ChatPage {
        back-requested => { root.current-page = "main"; }
    }

    // The one place a callback's failure becomes visible, whatever page raised it. It sits
    // at the top so it never covers the composer or a footer's controls.
    if NoticeGlobals.text != "": notice := NoticeToast {
        text: NoticeGlobals.text;
        is-error: NoticeGlobals.is-error;
        x: (root.width - notice.width) / 2;
        y: 16px;
        dismissed => { NoticeGlobals.text = ""; }
    }
}
