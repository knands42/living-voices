import { CharacterView, CharacterCreationInput } from "../views.slint";

export enum ChangedField {
    appearance, character-name, headline, backstory
}

export global CharacterGlobals {
    in property <CharacterView> character;

    // Only the owner of     the adventure sees the edit buttons.
    in property <bool> can-edit: true;

    // The appearance prompt run is in flight; the field it was read from stays dimmed.
    in property <bool> generating-prompts: false;

    // The portrait run is in flight
    in property <bool> generating-image: false;

    callback save-character(CharacterCreationInput, ChangedField);
    callback add-trait(string, string);
    callback remove-trait(string, int);
    callback add-tag(string, string);
    callback remove-tag(string, int);
    callback add-relation(string, string);
    callback remove-relation(string, int);
}
