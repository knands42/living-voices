import { AppTheme } from "theme.slint";
import {
    BuilderView, CharacterView, ActAuthorView,
    StoryInputView, CharacterInputView, ActInputView,
} from "views.slint";

// The builder page's data in, and its events out. Rust talks to this directly.
// The first argument of every callback is the adventure id.
export global BuilderGlobals {
    in property <BuilderView> builder;
    callback save-story(string, StoryInputView);
    callback save-character(string, CharacterInputView);
    callback save-act(string, ActInputView);
    callback save-opening(string, string);
    callback publish-adventure(string);
}

// A round initials badge, hue-tinted per character.
component CastAvatar inherits Rectangle {
    in property <string> initials;
    in property <int> hue;

    width: 36px;
    height: 36px;
    border-radius: AppTheme.radius-circle;
    background: hsv(root.hue, 0.35, 0.45);
    border-width: 1px;
    border-color: hsv(root.hue, 0.5, 0.75);

    Text {
        text: root.initials;
        color: AppTheme.text-light;
        font-family: AppTheme.font-body;
        font-size: AppTheme.font-label;
    }
}

// A navigation row in the left sidebar.
component NavRow inherits TouchArea {
    in property <string> label;
    in property <bool> done;
    in property <bool> active;
    in property <string> trailing;

    height: 42px;

    Rectangle {
        background: root.active
            ? AppTheme.bg-panel-alt
            : (parent.has-hover ? AppTheme.bg-panel-alt : transparent);
        border-radius: AppTheme.radius-card;
        border-width: root.active ? 1px : 0px;
        border-color: AppTheme.gold;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;

            Text {
                text: root.done ? "✓" : "○";
                color: root.done ? AppTheme.success : AppTheme.text-muted;
                font-family: AppTheme.font-body;
                vertical-alignment: center;
            }

            Text {
                text: root.label;
                color: root.active ? AppTheme.gold : AppTheme.text-light;
                font-family: AppTheme.font-body;
                font-size: AppTheme.font-heading;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.trailing;
                color: AppTheme.text-muted;
                font-family: AppTheme.font-body;
                font-size: AppTheme.font-label;
                vertical-alignment: center;
            }
        }
    }
}

// A pill-shaped gold action button.
component PillButton inherits TouchArea {
    in property <string> label;
    in property <bool> enabled-look: true;

    height: 36px;

    Rectangle {
        background: !root.enabled-look
            ? AppTheme.btn-brown
            : (parent.has-hover ? AppTheme.gold-bright : AppTheme.gold);
        border-radius: AppTheme.radius-pill;

        Text {
            text: root.label;
            color: root.enabled-look ? AppTheme.text-ink : AppTheme.text-muted;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-label;
        }
    }
}

// The heading shown at the top of each main-panel section.
component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;

    spacing: 2px;

    Text {
        text: root.title;
        color: AppTheme.gold;
        font-family: AppTheme.font-display;
        font-size: AppTheme.font-title;
    }
    Text {
        text: root.subtitle;
        color: AppTheme.text-muted;
        font-family: AppTheme.font-body;
        font-size: AppTheme.font-label;
        wrap: word-wrap;
    }
}

export component BuilderPage inherits Rectangle {
    in property <BuilderView> builder: BuilderGlobals.builder;

    callback back-requested();
    // Page-local: each one opens its editor (no listener until those editors exist).
    callback edit-story();
    callback edit-cast();
    callback edit-act();
    callback edit-opening();

    // Which section the main panel shows: "story" | "cast" | "acts" | "opening".
    property <string> section: "story";
    property <bool> publishable:
        builder.story-done && builder.cast-done && builder.acts-done && builder.opening-done;

    background: AppTheme.bg-deepest;

    HorizontalLayout {

        // ================= LEFT SIDEBAR =================
        left-sidebar := Rectangle {
            width: 240px;
            background: AppTheme.bg-panel;
            border-width: 1px;
            border-color: AppTheme.bronze;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // draft title + back
                HorizontalLayout {
                    spacing: 8px;

                    back-area := TouchArea {
                        width: 32px;
                        height: 32px;
                        clicked => { root.back-requested(); }

                        Rectangle {
                            background: parent.has-hover ? AppTheme.btn-brown : transparent;
                            border-radius: AppTheme.radius-pill;

                            Text {
                                text: "‹";
                                color: AppTheme.gold;
                                font-family: AppTheme.font-display;
                                font-size: AppTheme.font-title;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: "DRAFT · " + builder.status;
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-brand;
                            font-size: AppTheme.font-tiny;
                        }
                        Text {
                            text: builder.title == "" ? "Untitled adventure" : builder.title;
                            color: AppTheme.gold;
                            font-family: AppTheme.font-display;
                            font-size: AppTheme.font-card-title;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { height: 1px; background: AppTheme.bronze; }

                // nav rows
                NavRow {
                    label: "Story";
                    done: builder.story-done;
                    active: root.section == "story";
                    clicked => { root.section = "story"; }
                }
                NavRow {
                    label: "Cast";
                    done: builder.cast-done;
                    active: root.section == "cast";
                    trailing: builder.cast.length > 0 ? builder.cast.length : "";
                    clicked => { root.section = "cast"; }
                }
                NavRow {
                    label: "Acts";
                    done: builder.acts-done;
                    active: root.section == "acts";
                    trailing: builder.acts.length > 0 ? builder.acts.length : "";
                    clicked => { root.section = "acts"; }
                }
                NavRow {
                    label: "Opening";
                    done: builder.opening-done;
                    active: root.section == "opening";
                    clicked => { root.section = "opening"; }
                }

                Rectangle { vertical-stretch: 1; }

                // readiness + publish
                Rectangle { height: 1px; background: AppTheme.bronze; }

                HorizontalLayout {
                    Text {
                        text: "READINESS";
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-brand;
                        font-size: AppTheme.font-tiny;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: builder.ready-count + " / 4";
                        color: root.publishable ? AppTheme.success : AppTheme.amber-glow;
                        font-family: AppTheme.font-display;
                        font-size: AppTheme.font-card-title;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        height: 4px; border-radius: 2px;
                        background: builder.story-done ? AppTheme.success : AppTheme.bronze;
                    }
                    Rectangle {
                        height: 4px; border-radius: 2px;
                        background: builder.cast-done ? AppTheme.success : AppTheme.bronze;
                    }
                    Rectangle {
                        height: 4px; border-radius: 2px;
                        background: builder.acts-done ? AppTheme.success : AppTheme.bronze;
                    }
                    Rectangle {
                        height: 4px; border-radius: 2px;
                        background: builder.opening-done ? AppTheme.success : AppTheme.bronze;
                    }
                }

                PillButton {
                    label: root.publishable ? "Publish" : "Publish (locked)";
                    enabled-look: root.publishable;
                    enabled: root.publishable;
                    clicked => { BuilderGlobals.publish-adventure(root.builder.id); }
                }
            }
        }

        // ================= MAIN PANEL =================
        main-panel := Rectangle {
            background: AppTheme.bg-deepest;

            // ---- STORY ----
            if root.section == "story": VerticalLayout {
                padding: 28px;
                spacing: 20px;

                HorizontalLayout {
                    SectionHeader {
                        title: "The Story";
                        subtitle: "Title, headline, lore, narrator voice and tone.";
                        horizontal-stretch: 1;
                    }
                    PillButton {
                        label: "Edit story";
                        width: 120px;
                        clicked => { root.edit-story(); }
                    }
                }

                Rectangle {
                    background: AppTheme.bg-panel;
                    border-radius: AppTheme.radius-card;
                    border-width: 1px;
                    border-color: AppTheme.bronze;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "Headline";
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-brand;
                            font-size: AppTheme.font-tiny;
                        }
                        Text {
                            text: builder.headline == "" ? "— not set —" : builder.headline;
                            color: AppTheme.text-light;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-heading;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Narrator Name";
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-brand;
                            font-size: AppTheme.font-tiny;
                        }
                        Text {
                            text: builder.narrator-name == "" ? "—" : builder.narrator-name;
                            color: AppTheme.text-light;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-heading;
                        }

                        Text {
                            text: "Tone";
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-brand;
                            font-size: AppTheme.font-tiny;
                        }
                        Text {
                            text: builder.tone == "" ? "—" : builder.tone;
                            color: AppTheme.text-light;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-heading;
                        }
                    }
                }
            }

            // ---- CAST ----
            if root.section == "cast": VerticalLayout {
                padding: 28px;
                spacing: 20px;

                HorizontalLayout {
                    SectionHeader {
                        title: "The Cast";
                        subtitle: "Characters, their traits and relationships.";
                        horizontal-stretch: 1;
                    }
                    PillButton {
                        label: "+ Add character";
                        width: 150px;
                        clicked => { root.edit-cast(); }
                    }
                }

                if builder.cast.length == 0: Rectangle {
                    background: AppTheme.bg-panel;
                    border-radius: AppTheme.radius-card;
                    border-width: 1px;
                    border-color: AppTheme.bronze;
                    vertical-stretch: 1;

                    Text {
                        text: "No cast yet — add your first character.";
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label;
                    }
                }

                if builder.cast.length > 0: VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    vertical-stretch: 1;

                    for member in builder.cast: Rectangle {
                        height: 64px;
                        background: AppTheme.bg-panel;
                        border-radius: AppTheme.radius-card;
                        border-width: 1px;
                        border-color: AppTheme.bronze;

                        HorizontalLayout {
                            padding: 14px;
                            spacing: 14px;

                            CastAvatar {
                                initials: member.name == "" ? "?" : member.name;
                                hue: member.hue;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: member.headline;
                                    color: AppTheme.text-muted;
                                    font-family: AppTheme.font-body;
                                    font-size: AppTheme.font-label;
                                }
                            }
                        }
                    }
                }
            }

            // ---- ACTS ----
            if root.section == "acts": VerticalLayout {
                padding: 28px;
                spacing: 20px;

                HorizontalLayout {
                    SectionHeader {
                        title: "Acts";
                        subtitle: "The story's movements, in order. Each act has a goal.";
                        horizontal-stretch: 1;
                    }
                    PillButton {
                        label: "+ Add act";
                        width: 120px;
                        clicked => { root.edit-act(); }
                    }
                }

                if builder.acts.length == 0: Rectangle {
                    background: AppTheme.bg-panel;
                    border-radius: AppTheme.radius-card;
                    border-width: 1px;
                    border-color: AppTheme.bronze;
                    vertical-stretch: 1;

                    Text {
                        text: "No acts yet — add the first movement.";
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label;
                    }
                }

                if builder.acts.length > 0: VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    vertical-stretch: 1;

                    for act in builder.acts: Rectangle {
                        height: 66px;
                        background: AppTheme.bg-panel;
                        border-radius: AppTheme.radius-card;
                        border-width: 1px;
                        border-color: act.valid ? AppTheme.bronze : AppTheme.amber-glow;

                        HorizontalLayout {
                            padding: 14px;
                            spacing: 14px;

                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: AppTheme.radius-circle;
                                background: AppTheme.bg-panel-alt;
                                border-width: 1px;
                                border-color: AppTheme.gold;

                                Text {
                                    text: act.ordinal + 1;
                                    color: AppTheme.gold;
                                    font-family: AppTheme.font-display;
                                    font-size: AppTheme.font-label;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: act.valid ? act.goal : "— needs a goal —";
                                    color: act.valid ? AppTheme.text-light : AppTheme.amber-glow;
                                    font-family: AppTheme.font-body;
                                    font-size: AppTheme.font-heading;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: act.trigger == ""
                                        ? "no trigger — follows on"
                                        : "trigger: " + act.trigger;
                                    color: AppTheme.text-muted;
                                    font-family: AppTheme.font-body;
                                    font-size: AppTheme.font-tiny;
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "At least one act with a real goal is required.";
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-tiny;
                }
            }

            // ---- OPENING ----
            if root.section == "opening": VerticalLayout {
                padding: 28px;
                spacing: 20px;

                HorizontalLayout {
                    SectionHeader {
                        title: "The Opening";
                        subtitle: "Who is present at the start, and any opening messages.";
                        horizontal-stretch: 1;
                    }
                    PillButton {
                        label: "Set up opening";
                        width: 150px;
                        clicked => { root.edit-opening(); }
                    }
                }

                Rectangle {
                    background: AppTheme.bg-panel;
                    border-radius: AppTheme.radius-card;
                    border-width: 1px;
                    border-color: AppTheme.bronze;
                    vertical-stretch: 1;

                    Text {
                        text: builder.opening-done ? "Opening is set up." : "Not set up yet.";
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label;
                    }
                }
            }
        }
    }
}
