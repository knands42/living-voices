import { AppTheme } from "../theme.slint";
import { BuilderView, CharacterChatView } from "../views.slint";
import { CastAvatar, PillButton, SectionHeader } from "components.slint";

// A character card in the cast grid.
component CastCard inherits TouchArea {
    in property <CharacterChatView> character;

    Rectangle {
        background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.bg-panel;
        border-radius: AppTheme.radius-card;
        border-width: 1px;
        border-color: parent.has-hover ? AppTheme.gold : AppTheme.bronze;

        HorizontalLayout {
            padding: 16px;
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                CastAvatar {
                    width: 56px;
                    height: 56px;
                    initials: root.character.initials;
                    hue: root.character.hue;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;

                Text {
                    text: root.character.name;
                    color: AppTheme.text-light;
                    font-family: AppTheme.font-display;
                    font-size: AppTheme.font-card-title;
                    overflow: elide;
                }
                Text {
                    text: root.character.headline == "" ? "No headline yet" : root.character.headline;
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label + 1px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component CastSection inherits VerticalLayout {
    in property <BuilderView> builder;
    callback add-requested();
    callback character-clicked(string);

    padding: 28px;
    spacing: 20px;

    HorizontalLayout {
        SectionHeader {
            title: "The Cast";
            subtitle: "Characters, their traits and relationships.";
            horizontal-stretch: 1;
        }
        PillButton {
            label: "+ Add character";
            width: 150px;
            clicked => { root.add-requested(); }
        }
    }

    if builder.cast.length == 0: Rectangle {
        background: AppTheme.bg-panel;
        border-radius: AppTheme.radius-card;
        border-width: 1px;
        border-color: AppTheme.bronze;
        vertical-stretch: 1;

        Text {
            text: "No cast yet — add your first character.";
            color: AppTheme.text-muted;
            font-family: AppTheme.font-body;
            font-size: AppTheme.font-label;
        }
    }

    if builder.cast.length > 0: cast-grid := Flickable {
        vertical-stretch: 1;

        property <length> card-w: 320px;
        property <length> card-h: 104px;
        property <length> gap: 16px;
        property <int> cols: max(1, Math.floor(self.width / (self.card-w + self.gap)));

        content-height: Math.ceil(builder.cast.length / self.cols) * (self.card-h + self.gap);

        for character[index] in builder.cast: CastCard {
            x: Math.mod(index, cast-grid.cols) * (cast-grid.card-w + cast-grid.gap);
            y: Math.floor(index / cast-grid.cols) * (cast-grid.card-h + cast-grid.gap);
            width: cast-grid.card-w;
            height: cast-grid.card-h;
            character: character;
            clicked => { root.character-clicked(character.id); }
        }
    }
}
