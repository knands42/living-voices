import { AppTheme } from "../theme.slint";
import { BuilderView, CharacterChatView } from "../views.slint";
import { PillButton, PortraitFrame, SectionHeader } from "components.slint";

// A character card in the cast grid: the portrait on top, the read on the character below.
export component CastCard inherits TouchArea {
    in property <CharacterChatView> character;

    Rectangle {
        background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.bg-panel;
        border-radius: AppTheme.radius-card;
        border-width: 1px;
        border-color: parent.has-hover ? AppTheme.gold : AppTheme.bronze;
        clip: true;

        VerticalLayout {
            alignment: start;
            spacing: 0;

            PortraitFrame {
                height: 208px;
                source: root.character.portrait;
                initials: root.character.initials;
                hue: root.character.hue;
            }

            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: root.character.name;
                        color: AppTheme.text-light;
                        font-family: AppTheme.font-display;
                        font-size: AppTheme.font-card-title;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if root.character.genre != "": Rectangle {
                        height: 20px;
                        width: genre-text.preferred-width + 20px;
                        border-radius: AppTheme.radius-pill;
                        background: AppTheme.tag-fill;
                        border-width: 1px;
                        border-color: AppTheme.bronze;

                        HorizontalLayout {
                            alignment: center;

                            genre-text := Text {
                                text: root.character.genre;
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-brand;
                                font-size: AppTheme.font-tiny;
                            }
                        }
                    }

                    Rectangle {
                        height: 20px;
                        width: status-text.preferred-width + 20px;
                        border-radius: AppTheme.radius-pill;
                        background: root.character.status == "present"
                            ? AppTheme.success.with-alpha(0.18)
                            : AppTheme.amber-glow.with-alpha(0.18);

                        HorizontalLayout {
                            alignment: center;

                            status-text := Text {
                                text: "● " + root.character.status;
                                color: root.character.status == "present"
                                    ? AppTheme.success
                                    : AppTheme.amber-glow;
                                font-family: AppTheme.font-brand;
                                font-size: AppTheme.font-tiny;
                            }
                        }
                    }
                }

                Text {
                    height: 32px;
                    text: root.character.headline == ""
                        ? "No headline yet"
                        : root.character.headline;
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label + 1px;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: top;
                }

                if root.character.traits.length > 0: Text {
                    height: 30px;
                    text: root.character.traits[0];
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label;
                    font-italic: true;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: top;
                }

                FlexboxLayout {
                    height: 22px;
                    spacing: 4px;
                    flex-wrap: wrap;

                    for tag[index] in root.character.tags: Rectangle {
                        height: 20px;
                        width: tag-text.preferred-width + 16px;
                        border-radius: AppTheme.radius-pill;
                        background: AppTheme.tag-fill;
                        border-width: 1px;
                        border-color: AppTheme.bronze;

                        HorizontalLayout {
                            alignment: center;

                            tag-text := Text {
                                text: tag;
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-tiny;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component CastSection inherits VerticalLayout {
    in property <BuilderView> builder;
    callback add-requested();
    callback character-clicked(string);

    padding: 28px;
    spacing: 20px;

    HorizontalLayout {
        SectionHeader {
            title: "The Cast";
            subtitle: "Characters, their traits and relationships.";
            horizontal-stretch: 1;
        }
        PillButton {
            label: "+ Add character";
            width: 150px;
            clicked => { root.add-requested(); }
        }
    }

    if builder.cast.length == 0: Rectangle {
        background: AppTheme.bg-panel;
        border-radius: AppTheme.radius-card;
        border-width: 1px;
        border-color: AppTheme.bronze;
        vertical-stretch: 1;

        Text {
            text: "No cast yet — add your first character.";
            color: AppTheme.text-muted;
            font-family: AppTheme.font-body;
            font-size: AppTheme.font-label;
        }
    }

    if builder.cast.length > 0: cast-grid := Flickable {
        vertical-stretch: 1;

        property <length> card-w: 260px;
        property <length> card-h: 380px;
        property <length> gap: 16px;
        property <int> cols: max(1, Math.floor(self.width / (self.card-w + self.gap)));

        content-height: Math.ceil(builder.cast.length / self.cols) * (self.card-h + self.gap);

        for character[index] in builder.cast: CastCard {
            x: Math.mod(index, cast-grid.cols) * (cast-grid.card-w + cast-grid.gap);
            y: Math.floor(index / cast-grid.cols) * (cast-grid.card-h + cast-grid.gap);
            width: cast-grid.card-w;
            height: cast-grid.card-h;
            character: character;
            clicked => { root.character-clicked(character.id); }
        }
    }
}
