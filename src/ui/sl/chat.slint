import { AppTheme } from "theme.slint";

// ---------------------------------------------------------------------------
// Data shapes (Chat page)
// ---------------------------------------------------------------------------

export struct ChatCharacter {
    name: string,
    role: string,          // "Elf Ranger", "Wizard", "Rogue"
    glyph: string,         // single letter for the avatar
    hue: color,            // avatar tint
    active: bool,          // highlighted on the right-hand side
    location: string,      // "Alley"  (shown under active character)
    level: string,         // "Level 1"
    status: string,        // "Status" badge text
}

export struct ChatMessage {
    speaker: string,       // "Kaelen", "Narrator", "Morwyn"
    text: string,
    time: string,          // "14:32"
    narrator: bool,        // italic sepia style
    own: bool,             // right-aligned, slightly brighter
    kind: string,          // "" | "say" | "do" | "think" | "whisper"
    target: string,        // target character name for "say" / "whisper"
}

export struct NarratorEvent {
    body: string,          // "A guard rounds the corner, halting your progress!"
    event-label: string,   // "EVENT: A Guard Appears"
}

export struct StoryClockData {
    phase: string,         // "EVENING"
    time: string,          // "19:48"
}

export struct ActionMode {
    label: string,         // "Say", "Do", "Think", "Whisper"
}

// ---------------------------------------------------------------------------
// Atoms
// ---------------------------------------------------------------------------

component Avatar inherits Rectangle {
    in property <string> glyph;
    in property <color> hue;
    in property <length> size: AppTheme.avatar-md;
    in property <bool> ringed: false;

    width: root.size;
    height: root.size;
    border-radius: AppTheme.radius-circle;
    border-width: root.ringed ? 2px : 1px;
    border-color: root.ringed ? AppTheme.gold-bright : AppTheme.bronze;
    background: root.hue;

    Text {
        text: root.glyph;
        font-family: AppTheme.font-display;
        font-size: AppTheme.font-heading;
        color: AppTheme.text-light;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CharacterRow inherits Rectangle {
    in property <ChatCharacter> data;
    callback clicked;

    height: 72px;
    border-radius: AppTheme.radius-card;
    border-width: 1px;
    border-color: root.data.active ? AppTheme.gold : AppTheme.bronze;
    background: root.data.active ? AppTheme.glow-soft : AppTheme.card-leather;
    animate background, border-color { duration: AppTheme.hover-dur; easing: ease-out; }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        alignment: start;

        Avatar {
            glyph: root.data.glyph;
            hue: root.data.hue;
            size: 48px;
            ringed: root.data.active;
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;

            Text {
                text: root.data.name;
                font-family: AppTheme.font-display;
                font-size: AppTheme.font-heading;
                color: AppTheme.gold-bright;
                overflow: elide;
            }
            Text {
                text: root.data.role;
                font-family: AppTheme.font-body;
                font-size: AppTheme.font-label;
                color: AppTheme.text-muted;
                overflow: elide;
            }
            // Secondary line, only on the active row
            if root.data.active && root.data.location != "": Text {
                text: root.data.location + "  " + root.data.level;
                font-family: AppTheme.font-body;
                font-size: AppTheme.font-tiny;
                color: AppTheme.text-light;
                overflow: elide;
            }
        }
    }

    // "Active" badge, top-right corner of the active row
    if root.data.active: Rectangle {
        x: parent.width - self.width - 8px;
        y: 6px;
        width: 48px;
        height: 16px;
        border-radius: AppTheme.radius-pill;
        background: AppTheme.success;

        Text {
            text: "Active";
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-tiny;
            color: AppTheme.text-ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // "Status" chip under the active-badge area
    if root.data.active && root.data.status != "": Rectangle {
        x: parent.width - self.width - 8px;
        y: parent.height - self.height - 6px;
        width: 52px;
        height: 16px;
        border-radius: AppTheme.radius-pill;
        border-width: 1px;
        border-color: AppTheme.bronze;
        background: AppTheme.bg-panel-alt;

        Text {
            text: root.data.status;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-tiny;
            color: AppTheme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component MessageBubble inherits Rectangle {
    in property <ChatMessage> data;

    border-radius: AppTheme.radius-card;
    border-width: 1px;
    border-color: AppTheme.bubble-border;
    background: root.data.narrator
        ? AppTheme.bubble-narrator
        : (root.data.own ? AppTheme.bubble-user : AppTheme.bubble-bg);

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "[" + root.data.speaker + "]";
                font-family: AppTheme.font-display;
                font-size: AppTheme.font-label;
                color: AppTheme.gold-bright;
                font-italic: root.data.narrator;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.data.time;
                font-family: AppTheme.font-body;
                font-size: AppTheme.font-tiny;
                color: AppTheme.text-muted;
                font-italic: root.data.narrator;
                vertical-alignment: center;
            }
        }

        // Mode caption: tells you how this line was spoken (say to X, do, think, whisper to X)
        if root.data.kind != "": Text {
            text: root.data.kind == "say"
                ? "— says to " + root.data.target
                : (root.data.kind == "whisper"
                    ? "— whispers to " + root.data.target
                    : (root.data.kind == "do"
                        ? "— performs an action"
                        : (root.data.kind == "think"
                            ? "— inner thought"
                            : "")));
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-tiny;
            color: root.data.kind == "do"
                ? AppTheme.seg-action-text
                : (root.data.kind == "think"
                    ? AppTheme.seg-thought-text
                    : (root.data.kind == "whisper"
                        ? AppTheme.seg-whisper-text
                        : AppTheme.gold));
        }

        Text {
            text: root.data.text;
            font-family: AppTheme.font-body;
            font-size: 14px;
            color: AppTheme.text-light;
            font-italic: root.data.narrator
                || root.data.kind == "do"
                || root.data.kind == "think";
            wrap: word-wrap;
        }
    }
}

component NarratorNotice inherits Rectangle {
    in property <string> body;
    in property <string> label: "";

    border-radius: 3px;
    background: AppTheme.notice-bg;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 3px;

        if root.label != "": Text {
            text: root.label;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-tiny;
            color: AppTheme.text-narrator;
            horizontal-alignment: center;
        }

        Text {
            text: root.body;
            font-family: AppTheme.font-display;
            font-size: 14px;
            font-italic: true;
            color: AppTheme.text-narrator;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component ChatEntry inherits Rectangle {
    in property <ChatMessage> data;

    VerticalLayout {
        spacing: 0px;

        if root.data.narrator: Rectangle {
            height: notice.preferred-height;

            notice := NarratorNotice {
                label: root.data.speaker;
                body: root.data.text;
                width: Math.min(parent.width - 48px, 460px);
                x: (parent.width - self.width) / 2;
            }
        }

        if !root.data.narrator: Rectangle {
            height: bubble.preferred-height;

            bubble := MessageBubble {
                data: root.data;
                width: Math.min(parent.width - 40px, 560px);
                x: root.data.own ? parent.width - self.width : 0px;
            }
        }
    }
}

component ScrollRod inherits Rectangle {   // decorative wooden rod at top/bottom of parchment
    background: AppTheme.scroll-rod;
    height: 14px;
    border-radius: 7px;

    // Round end caps, slightly larger
    Rectangle {
        x: -6px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 18px;
        border-radius: 9px;
        background: AppTheme.scroll-rod;
    }
    Rectangle {
        x: parent.width - self.width + 6px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 18px;
        border-radius: 9px;
        background: AppTheme.scroll-rod;
    }
}

component ParchmentScroll inherits Rectangle {   // scroll backdrop + inner frame for the chat log
    background: transparent;

    VerticalLayout {
        spacing: 0px;

        ScrollRod {}

        Rectangle {   // parchment body
            background: AppTheme.bg-parchment;
            vertical-stretch: 1;

            Rectangle {   // subtle inner shadow at the sides
                x: 0;
                width: 10px;
                height: parent.height;
                background: @linear-gradient(90deg,
                    AppTheme.bg-parchment-dark 0%,
                    AppTheme.bg-parchment.transparentize(1.0) 100%);
            }
            Rectangle {
                x: parent.width - self.width;
                width: 10px;
                height: parent.height;
                background: @linear-gradient(270deg,
                    AppTheme.bg-parchment-dark 0%,
                    AppTheme.bg-parchment.transparentize(1.0) 100%);
            }

            @children
        }

        ScrollRod {}
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: AppTheme.control-h;
    min-width: 76px;
    border-radius: AppTheme.radius-pill;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? AppTheme.gold-bright : AppTheme.bronze;
    background: root.active ? AppTheme.glow-soft : AppTheme.card-leather;
    animate background, border-color, border-width { duration: AppTheme.hover-dur; easing: ease-out; }

    Text {
        text: root.label;
        font-family: AppTheme.font-brand;
        font-size: AppTheme.font-label;
        color: root.active ? AppTheme.gold-bright : AppTheme.text-light;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    states [
        hovered when ta.has-hover: {
            root.border-color: AppTheme.gold;
        }
    ]

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A chip inside the composer field that advertises ONE selected action mode:
// "Say to Morwyn", "Do", "Think", "Whisper to Morwyn". For modes that require a
// target (say / whisper) the target avatar is shown next to the text, and the
// text falls back to "…" when no target is picked yet. The composer shows one
// of these per selected mode (up to two), so a "Say + Do" turn reads clearly.
component ModeLabel inherits Rectangle {
    in property <int> mode;              // 0=say, 1=do, 2=think, 3=whisper
    in property <ChatCharacter> target;

    height: 32px;
    border-radius: AppTheme.radius-pill;
    border-width: 1px;
    border-color: AppTheme.bronze;
    background: root.mode == 1
        ? AppTheme.seg-action-bg
        : (root.mode == 2
            ? AppTheme.seg-thought-bg
            : (root.mode == 3
                ? AppTheme.bg-panel-alt
                : AppTheme.card-leather));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if root.mode == 0 || root.mode == 3: Avatar {
            glyph: root.target.glyph;
            hue: root.target.hue;
            size: 20px;
        }

        Text {
            text: root.mode == 0
                ? "Say to " + (root.target.name != "" ? root.target.name : "…")
                : (root.mode == 1
                    ? "Do"
                    : (root.mode == 2
                        ? "Think"
                        : "Whisper to " + (root.target.name != "" ? root.target.name : "…")));
            font-family: AppTheme.font-brand;
            font-italic: root.mode == 1 || root.mode == 2;
            font-size: AppTheme.font-label;
            color: root.mode == 1
                ? AppTheme.seg-action-text
                : (root.mode == 2
                    ? AppTheme.seg-thought-text
                    : (root.mode == 3
                        ? AppTheme.seg-whisper-text
                        : AppTheme.gold-bright));
            vertical-alignment: center;
        }
    }
}

// Editable one-line text field with a muted italic placeholder shown while
// empty. Enter fires `submitted` so the composer can send without touching the
// mouse.
component ComposerInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback submitted;

    background: transparent;
    forward-focus: input;

    input := TextInput {
        width: parent.width;
        height: parent.height;
        text <=> root.text;
        color: AppTheme.text-light;
        font-family: AppTheme.font-body;
        font-size: 14px;
        vertical-alignment: center;
        selection-background-color: AppTheme.gold;
        selection-foreground-color: AppTheme.text-ink;
        accepted => {
            root.submitted();
        }
    }

    if root.text == "": Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.placeholder;
        color: AppTheme.text-muted;
        font-family: AppTheme.font-body;
        font-italic: true;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ---------------------------------------------------------------------------
// Panels: Sidebar, Chat center, Right panel
// ---------------------------------------------------------------------------

component Sidebar inherits Rectangle {
    in property <[ChatCharacter]> characters;
    callback character-selected(string);

    width: 240px;
    background: AppTheme.bg-panel;

    Rectangle {   // right hairline divider
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: AppTheme.bronze;
    }

    Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;

        VerticalLayout {
            padding: AppTheme.pad-outer;
            spacing: AppTheme.gap-panel;

            for ch[i] in root.characters: CharacterRow {
                data: ch;
                clicked => {
                    root.character-selected(ch.name);
                }
            }

            Rectangle { height: 0px; }
        }
    }
}

component ChatCenter inherits Rectangle {
    in property <[ChatMessage]> messages;
    in property <[ActionMode]> action-modes;
    in property <[ChatCharacter]> characters;
    in-out property <ChatCharacter> whisper-target;
    in-out property <string> draft;

    // ---- Action selection ----------------------------------------------
    // The player may combine up to TWO actions in one turn (e.g. "Say" + "Do").
    //   mode-primary    always set, 0..3 (defaults to Say)
    //   mode-secondary  -1 = none, otherwise 0..3 and different from primary
    // Rust reads both on send and builds a one- or two-part message.
    in-out property <int> mode-primary: 0;
    in-out property <int> mode-secondary: -1;

    // True when any selected mode addresses someone (Say / Whisper).
    property <bool> needs-target: root.is-targeted(root.mode-primary)
        || root.is-targeted(root.mode-secondary);
    property <bool> can-send: root.draft != ""
        && (!root.needs-target || root.whisper-target.name != "");

    callback send-clicked;

    // Toggle action `i` in/out of the two-slot selection. Kept here (not in
    // Rust) so the buttons feel instant; Rust only reads the final choice.
    function toggle-mode(i: int) {
        if (i == root.mode-primary) {
            // Deselecting the primary: promote the secondary if there is one,
            // otherwise keep it — a turn always has at least one action.
            if (root.mode-secondary != -1) {
                root.mode-primary = root.mode-secondary;
                root.mode-secondary = -1;
            }
        } else if (i == root.mode-secondary) {
            root.mode-secondary = -1;              // deselect the secondary
        } else if (root.mode-secondary == -1) {
            root.mode-secondary = i;               // add as the second action
        } else {
            root.mode-secondary = i;               // replace the second action
        }
    }

    pure function is-targeted(mode: int) -> bool {
        mode == 0 || mode == 3
    }
    pure function is-selected(i: int) -> bool {
        i == root.mode-primary || i == root.mode-secondary
    }

    background: transparent;

    VerticalLayout {
        padding: AppTheme.pad-grid;
        spacing: AppTheme.pad-grid;

        // ---- parchment scroll with message bubbles ----
        ParchmentScroll {
            vertical-stretch: 1;

            log := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: col.preferred-height;

                // Keep the newest message in view: whenever the content grows
                // past the viewport, pin the scroll to the bottom.
                content-y: min(0px, self.height - self.content-height);

                col := VerticalLayout {
                    padding-left: AppTheme.pad-card;
                    padding-right: AppTheme.pad-card;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 10px;

                    // Every message — player lines, character replies AND
                    // narration — flows here in order, so a new line always
                    // lands after the latest narration, never above it.
                    for msg[i] in root.messages: ChatEntry {
                        data: msg;
                        width: parent.width;
                    }

                    Rectangle { height: 0px; }
                }
            }
        }

        // ---- composer field: mode label(s) + editable input + send ----
        Rectangle {
            height: 56px;
            border-radius: AppTheme.radius-card;
            border-width: 1px;
            border-color: root.can-send ? AppTheme.gold-bright : AppTheme.gold;
            background: AppTheme.field-bg;
            animate border-color { duration: AppTheme.hover-dur; easing: ease-out; }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 10px;
                alignment: stretch;

                // Vertical-centering wrapper so the labels don't stretch to 56px.
                // One label per selected action: "Say to Morwyn", "+ Do", …
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        ModeLabel {
                            mode: root.mode-primary;
                            target: root.whisper-target;
                        }
                        if root.mode-secondary != -1: ModeLabel {
                            mode: root.mode-secondary;
                            target: root.whisper-target;
                        }
                    }
                }

                ComposerInput {
                    horizontal-stretch: 1;
                    text <=> root.draft;
                    placeholder: root.needs-target && root.whisper-target.name == ""
                        ? "Pick someone to address below…"
                        : "Write your turn…";
                    submitted => {
                        if (root.can-send) {
                            root.send-clicked();
                        }
                    }
                }

                send-area := TouchArea {
                    width: 44px;
                    mouse-cursor: root.can-send ? pointer : default;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: AppTheme.radius-circle;
                        background: root.can-send ? AppTheme.glow-soft : transparent;
                        animate background { duration: AppTheme.hover-dur; easing: ease-out; }

                        Text {
                            text: "➤";
                            font-size: AppTheme.font-title;
                            color: root.can-send ? AppTheme.gold-bright : AppTheme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    clicked => {
                        if (root.can-send) {
                            root.send-clicked();
                        }
                    }
                }
            }
        }

        // ---- action-mode bar: Say / Do / Think / Whisper (pick up to two) ----
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            height: AppTheme.control-h;

            for mode[i] in root.action-modes: ActionButton {
                label: mode.label;
                active: root.is-selected(i);
                clicked => {
                    root.toggle-mode(i);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "⚙";
                font-size: AppTheme.font-title;
                color: AppTheme.text-muted;
                vertical-alignment: center;
            }
        }

        // ---- helper row: target picker when a mode needs one, else a hint ----
        Rectangle {
            height: 48px;

            if root.needs-target: HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Text {
                    text: "Address:";
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label;
                    color: AppTheme.text-muted;
                    vertical-alignment: center;
                }

                for ch[i] in root.characters: TouchArea {
                    width: 44px;
                    height: 44px;
                    mouse-cursor: pointer;

                    Avatar {
                        glyph: ch.glyph;
                        hue: ch.hue;
                        size: 36px;
                        ringed: ch.name == root.whisper-target.name;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    clicked => {
                        root.whisper-target = ch;
                    }
                }
            }

            if !root.needs-target: HorizontalLayout {
                alignment: center;

                Text {
                    text: "Pick one or two actions above, then write your turn.";
                    font-family: AppTheme.font-body;
                    font-italic: true;
                    font-size: AppTheme.font-label;
                    color: AppTheme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component NarratorCard inherits Rectangle {
    in property <NarratorEvent> event;

    border-radius: AppTheme.radius-card;
    border-width: 1px;
    border-color: AppTheme.bronze;
    background: AppTheme.bg-panel-alt;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Narrator";
                font-family: AppTheme.font-display;
                font-size: AppTheme.font-title;
                color: AppTheme.gold-bright;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "✎";   // edit sigil
                font-size: AppTheme.font-heading;
                color: AppTheme.text-muted;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.event.body;
            font-family: AppTheme.font-display;
            font-size: 14px;
            font-italic: true;
            color: AppTheme.text-light;
            wrap: word-wrap;
        }

        Rectangle {   // bronze hairline divider
            height: 1px;
            background: AppTheme.bronze;
        }

        Text {
            text: root.event.event-label;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-label;
            color: AppTheme.gold;
        }
    }
}

component SceneImage inherits Rectangle {
    in property <color> tint: #2a1f14;    // placeholder until an image is wired

    height: 170px;
    border-radius: AppTheme.radius-card;
    border-width: 1px;
    border-color: AppTheme.bronze;
    background: root.tint;
    clip: true;

    // Faint vignette so the placeholder reads as "scene", not a flat block
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(180deg,
            AppTheme.scrim.transparentize(0.6) 0%,
            AppTheme.scrim.transparentize(1.0) 50%,
            AppTheme.scrim.transparentize(0.5) 100%);
    }

    Text {
        text: "Scene";
        font-family: AppTheme.font-brand;
        font-size: AppTheme.font-tiny;
        color: AppTheme.text-muted;
        x: 10px;
        y: parent.height - self.height - 8px;
    }
}

component StoryClock inherits Rectangle {
    in property <StoryClockData> clock;

    border-radius: AppTheme.radius-card;
    border-width: 1px;
    border-color: AppTheme.bronze;
    background: AppTheme.bg-panel-alt;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: center;

        Text {
            text: "Story Clock";
            font-family: AppTheme.font-display;
            font-size: AppTheme.font-heading;
            color: AppTheme.text-light;
            horizontal-alignment: center;
        }
        Text {
            text: root.clock.phase;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-title;
            color: AppTheme.gold-bright;
            horizontal-alignment: center;
        }

        // Simple sundial medallion
        Rectangle {
            height: 120px;
            width: 120px;
            x: (parent.width - self.width) / 2;
            border-radius: AppTheme.radius-circle;
            border-width: 2px;
            border-color: AppTheme.bronze;
            background: AppTheme.card-leather;

            Rectangle {   // gnomon tick
                x: parent.width / 2 - 1px;
                y: 10px;
                width: 2px;
                height: parent.height / 2 - 8px;
                background: AppTheme.gold;
            }

            Text {
                text: root.clock.time;
                font-family: AppTheme.font-display;
                font-size: AppTheme.font-title;
                color: AppTheme.gold-bright;
                horizontal-alignment: center;
                vertical-alignment: center;
                y: parent.height / 2 + 4px;
                width: parent.width;
            }
        }
    }
}

component RightPanel inherits Rectangle {
    in property <NarratorEvent> event;
    in property <StoryClockData> clock;

    width: 260px;
    background: AppTheme.bg-panel;

    Rectangle {   // left hairline divider
        width: 1px;
        height: parent.height;
        background: AppTheme.bronze;
    }

    VerticalLayout {
        padding: AppTheme.pad-outer;
        spacing: AppTheme.gap-panel;

        NarratorCard {
            event: root.event;
        }
        SceneImage {}
        StoryClock {
            clock: root.clock;
        }

        Rectangle { vertical-stretch: 1; }
    }
}

// ---------------------------------------------------------------------------
// Chat page — hosted by RootWindow in app.slint
// ---------------------------------------------------------------------------

export component ChatPage inherits Rectangle {
    background: transparent;

    in property <[ChatCharacter]> characters;
    in property <[ChatMessage]> messages;
    in property <[ActionMode]> action-modes;
    in-out property <int> mode-primary: 0;
    in-out property <int> mode-secondary: -1;
    in-out property <ChatCharacter> whisper-target;
    in-out property <string> draft;
    in property <NarratorEvent> narrator-event;
    in property <StoryClockData> story-clock;

    // ---- callbacks ----
    callback character-selected(string);
    callback send-message();

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        Sidebar {
            characters: root.characters;
            character-selected(name) => {
                root.character-selected(name);
            }
        }

        ChatCenter {
            horizontal-stretch: 1;
            messages: root.messages;
            action-modes: root.action-modes;
            mode-primary <=> root.mode-primary;
            mode-secondary <=> root.mode-secondary;
            characters: root.characters;
            whisper-target <=> root.whisper-target;
            draft <=> root.draft;
            send-clicked => {
                root.send-message();
            }
        }

        RightPanel {
            event: root.narrator-event;
            clock: root.story-clock;
        }
    }
}
