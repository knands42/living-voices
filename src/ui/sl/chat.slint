import { LineEdit, VerticalBox } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { ChatBubble, NarratorBubble } from "chat_bubble.slint";
import {
    AdventureView,
    ActView,
    StateView,
    FactView,
    MessageView,
} from "views.slint";

export component ChatPage inherits Rectangle {
    in property <AdventureView> adventure;
    in property <ActView> act;
    in property <StateView> state;
    in property <[FactView]> facts;
    in property <[MessageView]> messages;
    in property <bool> awaiting-reply;
    callback back-requested();
    callback message-sent(string);

    property <float> scale: max(0.85, min(1.15, root.width / 1100px));
    property <length> gap-sm: 8px * root.scale;
    property <length> gap-md: 16px * root.scale;
    property <length> gap-lg: 24px * root.scale;
    property <length> pad-page: 32px * root.scale;
    property <length> side-w: 250px * root.scale;
    property <length> meta-w: 280px * root.scale;

    awaiting-reply: false;
    background: AppTheme.bg-deepest;

    VerticalLayout {
        spacing: root.gap-md;
        padding: root.pad-page;

        HorizontalLayout {
            spacing: root.gap-md;

            TouchArea {
                width: 80px * root.scale;
                height: 40px * root.scale;
                clicked => { root.back-requested(); }

                Rectangle {
                    background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.bg-panel;
                    border-radius: AppTheme.radius-pill;
                    border-width: 1px;
                    border-color: AppTheme.bronze;

                    Text {
                        text: "← Back";
                        color: AppTheme.text-light;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label * root.scale;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px * root.scale;

                Text {
                    text: root.adventure.title;
                    color: AppTheme.gold;
                    font-family: AppTheme.font-brand;
                    font-size: AppTheme.font-title * root.scale;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.adventure.headline;
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label * root.scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "Act " + root.act.ordinal + " — " + root.act.goal;
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label * root.scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                width: 80px * root.scale;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: root.gap-md;

            VerticalLayout {
                width: root.side-w;
                vertical-stretch: 1;
                spacing: root.gap-sm;

                Text {
                    text: "Cast";
                    color: AppTheme.gold;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-heading * root.scale;
                }

                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: root.gap-md;

                        VerticalLayout {
                            spacing: 2px * root.scale;

                            Text {
                                text: root.adventure.player.name;
                                color: hsv(root.adventure.player.hue, 0.45, 0.95);
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                                font-weight: 600;
                            }

                            Text {
                                text: root.adventure.player.headline;
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                                wrap: word-wrap;
                            }
                        }

                        for character in root.adventure.characters: VerticalLayout {
                            spacing: 2px * root.scale;

                            Text {
                                text: character.name;
                                color: hsv(character.hue, 0.45, 0.95);
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                                font-weight: 600;
                            }

                            Text {
                                text: character.headline;
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // chat
            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: root.gap-md;

                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: root.gap-md;

                        for message in root.messages: HorizontalLayout {
                            alignment: message.is-narrator ? stretch
                                : message.is-player ? end : start;

                            if message.is-narrator: NarratorBubble {
                                text: message.text;
                                scale: root.scale;
                                horizontal-stretch: 1;
                            }

                            if !message.is-narrator: ChatBubble {
                                max-width: root.width * 0.45;
                                speaker: message.speaker;
                                text: message.text;
                                is-player: message.is-player;
                                hue: message.hue;
                                scale: root.scale;
                            }
                        }

                        if root.awaiting-reply: Text {
                            text: "…";
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-heading * root.scale;
                        }
                    }
                }

                composer := LineEdit {
                    placeholder-text: "Say something…";
                    font-family: AppTheme.font-body;
                    font-size: 14px * root.scale;
                    height: 50px * root.scale;
                    enabled: !root.awaiting-reply;
                    accepted(text) => {
                        if (text != "") {
                            root.message-sent(text);
                            composer.text = "";
                        }
                    }
                }
            }

            VerticalLayout {
                width: root.meta-w;
                vertical-stretch: 1;
                spacing: root.gap-md;

                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: root.gap-sm;

                        Text {
                            text: "What's going on";
                            color: AppTheme.gold;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-heading * root.scale;
                        }

                        Text {
                            text: "Conditions";
                            color: AppTheme.amber-glow;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-label * root.scale;
                        }

                        for condition in root.state.conditions: Text {
                            text: "· " + condition;
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-label * root.scale;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Open threads";
                            color: AppTheme.amber-glow;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-label * root.scale;
                        }

                        for thread in root.state.open-threads: Text {
                            text: "· " + thread;
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-label * root.scale;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Facts";
                            color: AppTheme.amber-glow;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-label * root.scale;
                        }

                        for fact in root.facts: VerticalLayout {
                            spacing: 2px * root.scale;

                            Text {
                                text: fact.subject;
                                color: AppTheme.bronze;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                            }

                            Text {
                                text: fact.fact;
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    spacing: root.gap-sm;

                    Text {
                        text: "Time and place";
                        color: AppTheme.gold;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-heading * root.scale;
                    }

                    Text {
                        text: root.state.day;
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label * root.scale;
                    }

                    Text {
                        text: root.state.place;
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label * root.scale;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
