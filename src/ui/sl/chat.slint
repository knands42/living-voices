import { LineEdit, VerticalBox } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { ChatBubble, NarratorBubble } from "chat_bubble.slint";
import { SelectableText } from "selectable_text.slint";
import { PortraitFrame } from "builder/components.slint";
import { CastCard } from "builder/cast_section.slint";
import {
    AdventureView,
    ActView,
    StateView,
    FactView,
    MessageView,
} from "views.slint";

// The chat page's data in, and its events out. Rust talks to this directly.
export global ChatGlobals {
    in property <AdventureView> adventure;
    in property <ActView> act;
    in property <StateView> state;
    in property <[FactView]> facts;
    in property <[MessageView]> messages;
    in property <bool> awaiting-reply;
    callback message-sent(string);
}

export component ChatPage inherits Rectangle {
    in property <AdventureView> adventure: ChatGlobals.adventure;
    in property <ActView> act: ChatGlobals.act;
    in property <StateView> state: ChatGlobals.state;
    in property <[FactView]> facts: ChatGlobals.facts;
    in property <[MessageView]> messages: ChatGlobals.messages;
    in property <bool> awaiting-reply: ChatGlobals.awaiting-reply;
    callback back-requested();

    property <float> scale: max(0.85, min(1.15, root.width / 1100px));
    property <length> gap-sm: 8px * root.scale;
    property <length> gap-md: 16px * root.scale;
    property <length> gap-lg: 24px * root.scale;
    property <length> pad-page: 32px * root.scale;
    property <length> side-w: 250px * root.scale;
    property <length> side-max-w: 380px * root.scale;
    property <length> meta-w: 280px * root.scale;
    property <length> meta-max-w: 420px * root.scale;
    property <length> chat-max-w: 860px * root.scale;

    // The cast row under the pointer and where it sits, so the detail card can follow it.
    in-out property <int> hovered-cast: -1;
    property <length> hovered-y: 0;

    background: AppTheme.bg-deepest;

    VerticalLayout {
        spacing: root.gap-md;
        padding: root.pad-page;

        HorizontalLayout {
            spacing: root.gap-md;

            TouchArea {
                width: 80px * root.scale;
                height: 40px * root.scale;
                clicked => { root.back-requested(); }

                Rectangle {
                    background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.bg-panel;
                    border-radius: AppTheme.radius-pill;
                    border-width: 1px;
                    border-color: AppTheme.bronze;

                    Text {
                        text: "← Back";
                        color: AppTheme.text-light;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label * root.scale;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px * root.scale;

                SelectableText {
                    text: root.adventure.title;
                    color: AppTheme.gold;
                    font-family: AppTheme.font-brand;
                    font-size: AppTheme.font-title * root.scale;
                    horizontal-alignment: center;
                }

                SelectableText {
                    text: root.adventure.headline;
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label * root.scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                SelectableText {
                    text: "Act " + root.act.ordinal + " — " + root.act.goal;
                    color: AppTheme.text-muted;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label * root.scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                width: 80px * root.scale;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: root.gap-md;

            cast-panel := Rectangle {
                min-width: root.side-w;
                max-width: root.side-max-w;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: AppTheme.bg-panel;
                border-radius: AppTheme.radius-card;
                border-width: 1px;

                VerticalLayout {
                    padding: root.gap-md;
                    spacing: root.gap-sm;

                    Text {
                        text: "Cast";
                        color: AppTheme.gold;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-heading * root.scale;
                    }

                    Flickable {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: start;
                            spacing: root.gap-md;

                            HorizontalLayout {
                                spacing: 10px * root.scale;

                                PortraitFrame {
                                    width: 40px * root.scale;
                                    height: 52px * root.scale;
                                    border-radius: AppTheme.radius-card;
                                    source: root.adventure.player.portrait;
                                    initials: root.adventure.player.initials;
                                    hue: root.adventure.player.hue;
                                }

                                VerticalLayout {
                                    alignment: start;
                                    horizontal-stretch: 1;
                                    spacing: 2px * root.scale;

                                    SelectableText {
                                        text: root.adventure.player.name;
                                        color: hsv(root.adventure.player.hue, 0.45, 0.95);
                                        font-family: AppTheme.font-body;
                                        font-size: AppTheme.font-label * root.scale;
                                        font-weight: 600;
                                    }

                                    SelectableText {
                                        text: root.adventure.player.headline;
                                        color: AppTheme.text-muted;
                                        font-family: AppTheme.font-body;
                                        font-size: AppTheme.font-label * root.scale;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            for character[index] in root.adventure.characters: cast-row := TouchArea {
                                height: cast-row-content.preferred-height;

                                changed has-hover => {
                                    if (cast-row.has-hover) {
                                        root.hovered-cast = index;
                                        root.hovered-y = cast-row.absolute-position.y - root.absolute-position.y;
                                    } else if (root.hovered-cast == index) {
                                        root.hovered-cast = -1;
                                    }
                                }

                                cast-row-content := HorizontalLayout {
                                    spacing: 10px * root.scale;

                                    PortraitFrame {
                                        width: 40px * root.scale;
                                        height: 52px * root.scale;
                                        border-radius: AppTheme.radius-card;
                                        source: character.portrait;
                                        initials: character.initials;
                                        hue: character.hue;
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px * root.scale;

                                        SelectableText {
                                            text: character.name;
                                            color: hsv(character.hue, 0.45, 0.95);
                                            font-family: AppTheme.font-body;
                                            font-size: AppTheme.font-label * root.scale;
                                            font-weight: 600;
                                        }

                                        SelectableText {
                                            text: character.headline;
                                            color: AppTheme.text-muted;
                                            font-family: AppTheme.font-body;
                                            font-size: AppTheme.font-label * root.scale;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // chat
            Rectangle {
                horizontal-stretch: 2;
                max-width: root.chat-max-w;
                vertical-stretch: 1;
                background: AppTheme.bg-panel;
                border-radius: AppTheme.radius-card;
                border-width: 1px;

                VerticalLayout {
                    padding: root.gap-lg;
                    spacing: root.gap-md;

                    Flickable {
                        vertical-stretch: 1;
                        mouse-drag-pan-enabled: false;

                        VerticalLayout {
                            alignment: start;
                            spacing: root.gap-md;

                            for message in root.messages: HorizontalLayout {
                                alignment: message.is-narrator ? stretch
                                    : message.is-player ? end : start;

                                if message.is-narrator: NarratorBubble {
                                    text: message.text;
                                    scale: root.scale;
                                    horizontal-stretch: 1;
                                }

                                if !message.is-narrator: ChatBubble {
                                    max-width: root.width * 0.45;
                                    speaker: message.speaker;
                                    text: message.text;
                                    is-player: message.is-player;
                                    hue: message.hue;
                                    scale: root.scale;
                                }
                            }

                            if root.awaiting-reply: Text {
                                text: "…";
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-heading * root.scale;
                            }
                        }
                    }

                    composer := LineEdit {
                        placeholder-text: "Say something…";
                        font-family: AppTheme.font-body;
                        font-size: 14px * root.scale;
                        height: 50px * root.scale;
                        enabled: !root.awaiting-reply;
                        accepted(text) => {
                            if (text != "") {
                                ChatGlobals.message-sent(text);
                                composer.text = "";
                            }
                        }
                    }
                }
            }

            Rectangle {
                min-width: root.meta-w;
                max-width: root.meta-max-w;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: AppTheme.bg-panel;
                border-radius: AppTheme.radius-card;
                border-width: 1px;

                VerticalLayout {
                    padding: root.gap-md;
                    spacing: root.gap-md;

                    Flickable {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: start;
                            spacing: root.gap-sm;

                            Text {
                                text: "What's going on";
                                color: AppTheme.gold;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-heading * root.scale;
                            }

                            Text {
                                text: "Conditions";
                                color: AppTheme.amber-glow;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                            }

                            for condition in root.state.conditions: SelectableText {
                                text: "· " + condition;
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Open threads";
                                color: AppTheme.amber-glow;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                            }

                            for thread in root.state.open-threads: SelectableText {
                                text: "· " + thread;
                                color: AppTheme.text-muted;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Facts";
                                color: AppTheme.amber-glow;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-label * root.scale;
                            }

                            for fact in root.facts: VerticalLayout {
                                spacing: 2px * root.scale;

                                SelectableText {
                                    text: fact.subject;
                                    color: AppTheme.bronze;
                                    font-family: AppTheme.font-body;
                                    font-size: AppTheme.font-label * root.scale;
                                }

                                SelectableText {
                                    text: fact.fact;
                                    color: AppTheme.text-muted;
                                    font-family: AppTheme.font-body;
                                    font-size: AppTheme.font-label * root.scale;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 1;
                        alignment: start;
                        spacing: root.gap-sm;

                        Text {
                            text: "Time and place";
                            color: AppTheme.gold;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-heading * root.scale;
                        }

                        SelectableText {
                            text: root.state.day;
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-label * root.scale;
                        }

                        SelectableText {
                            text: root.state.place;
                            color: AppTheme.text-muted;
                            font-family: AppTheme.font-body;
                            font-size: AppTheme.font-label * root.scale;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // The cast card the builder's grid uses, floating beside the row being hovered so the
    // list itself keeps its one-line summary.
    if root.hovered-cast >= 0 && root.hovered-cast < root.adventure.characters.length: detail := CastCard {
        character: root.adventure.characters[root.hovered-cast];
        width: 260px * root.scale;
        height: 380px * root.scale;
        x: cast-panel.absolute-position.x - root.absolute-position.x
            + cast-panel.width + root.gap-sm;
        y: min(root.height - detail.height - root.pad-page,
            max(root.pad-page, root.hovered-y));
    }
}
