import { AppTheme } from "theme.slint";
import { AdventureView, ActView, StateView, FactView } from "views.slint";

export component ChatPage inherits Rectangle {
    in property <AdventureView> adventure;
    in property <ActView> act;
    in property <StateView> state;
    in property <[FactView]> facts;
    callback back-requested();

    background: AppTheme.bg-deepest;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: root.adventure.title;
            color: AppTheme.gold;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-title;
            horizontal-alignment: center;
        }

        Text {
            text: "Act " + root.act.ordinal + " — " + root.act.goal;
            color: AppTheme.text-muted;
            font-family: AppTheme.font-body;
            font-size: AppTheme.font-label;
            horizontal-alignment: center;
        }

        Text {
            text: root.state.day + " · " + root.state.place;
            color: AppTheme.text-muted;
            font-family: AppTheme.font-body;
            font-size: AppTheme.font-label;
            horizontal-alignment: center;
        }

        TouchArea {
            height: 40px;
            clicked => { root.back-requested(); }

            Rectangle {
                background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.bg-panel;
                border-radius: AppTheme.radius-pill;
                border-width: 1px;
                border-color: AppTheme.bronze;

                Text {
                    text: "← Back";
                    color: AppTheme.text-light;
                    font-family: AppTheme.font-body;
                    font-size: AppTheme.font-label;
                }
            }
        }
    }
}
