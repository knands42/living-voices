export struct CharacterView {
    id: string,
    name: string,
    headline: string,
    is-player: bool,
}

export struct AdventureView {
    id: string,
    title: string,
    headline: string,
    tone: string,
    characters: [CharacterView],
    player: CharacterView,
}

export struct ActView {
    goal: string,
    status: string,
    ordinal: int,
}

export struct StateView {
    day: string,
    place: string,
    characters-present: [string],
    open-threads: [string],
    conditions: [string],
}

export struct FactView {
    subject: string,
    fact: string,
    permanence: string,
}

export struct MessageView {
    speaker: string,
    text: string,
    is-player: bool,
    is-narrator: bool
}
