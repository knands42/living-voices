export struct CharacterView {
    id: string,
    name: string,
    headline: string,
    is-player: bool,
    hue: int,
}

export struct AdventureView {
    id: string,
    title: string,
    headline: string,
    tone: string,
    characters: [CharacterView],
    player: CharacterView,
}

export struct ActAuthorView {
    ordinal: int,
    goal: string,
    trigger: string,
    valid: bool,
}

export struct BuilderView {
    id: string,
    title: string,
    headline: string,
    status: string,
    narrator-name: string,
    tone: string,
    cast: [CharacterView],
    acts: [ActAuthorView],
    story-done: bool,
    cast-done: bool,
    acts-done: bool,
    opening-done: bool,
    ready-count: int,
}

export struct ActView {
    goal: string,
    status: string,
    ordinal: int,
}

export struct StateView {
    day: string,
    place: string,
    characters-present: [string],
    open-threads: [string],
    conditions: [string],
}

export struct FactView {
    subject: string,
    fact: string,
    permanence: string,
}

export struct MessageView {
    speaker: string,
    text: string,
    is-player: bool,
    is-narrator: bool,
    hue: int,
}
