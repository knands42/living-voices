export struct AdventureView {
    id: string,
    title: string,
    headline: string,
    tone: string,
}

export struct ActView {
    goal: string,
    status: string,
    ordinal: int,
}

export struct StateView {
    day: string,
    place: string,
    characters-present: [string],
    open-threads: [string],
    conditions: [string],
}

export struct FactView {
    subject: string,
    fact: string,
    permanence: string,
}
