export struct CharacterChatView {
    id: string,
    name: string,
    genre: string,
    initials: string,
    headline: string,
    status: string,
    traits: [string],
    tags: [string],
    portrait: image,
    is-player: bool,
    hue: int,
}

// Everything the character page shows. Empty string means "not set".
export struct CharacterView {
    id: string,
    adventure-id: string,
    name: string,
    genre: string,
    initials: string,
    hue: int,
    headline: string,
    status: string,
    backstory: string,
    appearance: string,
    appearance-identity-prompt: string,
    appearance-current-outfit: string,
    appearance-current-pose: string,
    is-player: bool,
    traits: [string],
    tags: [string],
    relations: [string],
}

export struct CharacterCreationInput {
    name: string,
    genre: string,
    headline: string,
    backstory: string,
    appearance: string,
}

export struct AdventureView {
    id: string,
    title: string,
    headline: string,
    tone: string,
    characters: [CharacterChatView],
    player: CharacterChatView,
    lore: string,
    status: string
}

export struct StoryInputView {
    title: string,
    headline: string,
    tone: string,
    narrator-name: string,
    lore: string,
}

// An empty id means a new act.
export struct ActInputView {
    id: string,
    goal: string,
    trigger: string,
}

export struct ActAuthorView {
    ordinal: int,
    goal: string,
    trigger: string,
    valid: bool,
}

export struct BuilderView {
    id: string,
    title: string,
    headline: string,
    status: string,
    narrator-name: string,
    tone: string,
    lore: string,
    cast: [CharacterChatView],
    acts: [ActAuthorView],
    story-done: bool,
    cast-done: bool,
    acts-done: bool,
    opening-done: bool,
    ready-count: int,
}

export struct ActView {
    goal: string,
    status: string,
    ordinal: int,
}

export struct StateView {
    day: string,
    place: string,
    characters-present: [string],
    open-threads: [string],
    conditions: [string],
}

export struct FactView {
    subject: string,
    fact: string,
    permanence: string,
}

export struct MessageView {
    speaker: string,
    text: string,
    is-player: bool,
    is-narrator: bool,
    hue: int,
}
