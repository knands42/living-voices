import { LineEdit, TextEdit } from "std-widgets.slint";
import { AppTheme } from "../theme.slint";

// A small square button used for the confirm / cancel actions.
export component IconButton inherits TouchArea {
    in property <string> glyph;
    in property <bool> primary: false;

    width: 34px;
    height: 34px;

    Rectangle {
        background: root.primary
            ? (root.has-hover ? AppTheme.gold-bright : AppTheme.gold)
            : (root.has-hover ? AppTheme.bg-panel-alt : AppTheme.btn-brown);
        border-radius: 8px;

        Text {
            text: root.glyph;
            color: root.primary ? AppTheme.text-ink : AppTheme.text-light;
            font-size: 16px;
        }
    }
}

// Wrapped prose that takes the height its text needs and scrolls past the cap.
component ProseText inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <length> font-size;
    in property <string> font-family;
    in property <color> text-color;
    in property <TextHorizontalAlignment> text-alignment: left;
    in property <length> min-view-height: 0px;
    in property <length> max-view-height: 100000px;

    height: min(max(body.preferred-height, root.min-view-height), root.max-view-height);

    Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: max(self.height, body.preferred-height);

        body := Text {
            width: parent.width;
            text: root.value == "" ? root.placeholder : root.value;
            color: root.value == "" ? AppTheme.text-muted : root.text-color;
            font-family: root.font-family;
            font-size: root.font-size;
            font-italic: root.value == "";
            wrap: word-wrap;
            horizontal-alignment: root.text-alignment;
        }
    }
}

export component EditableField inherits VerticalLayout {
    in property <string> value;
    in property <string> placeholder: "Not set yet";
    in property <bool> can-edit: false;
    in property <bool> multiline: false;
    in property <length> font-size: AppTheme.font-heading + 2px;
    in property <string> font-family: AppTheme.font-body;
    in property <color> text-color: AppTheme.text-light;
    in property <TextHorizontalAlignment> text-alignment: left;
    in property <length> min-view-height: 0px;
    in property <length> max-view-height: 100000px;
    callback committed(string);

    property <bool> editing: false;

    function commit(text: string) {
        if (text != root.value) {
            root.committed(text);
        }
        root.editing = false;
    }

    if !root.editing: HorizontalLayout {
        spacing: 10px;

        ProseText {
            value: root.value;
            placeholder: root.placeholder;
            font-family: root.font-family;
            font-size: root.font-size;
            text-color: root.text-color;
            text-alignment: root.text-alignment;
            min-view-height: root.min-view-height;
            max-view-height: root.max-view-height;
            horizontal-stretch: 1;
        }

        if root.can-edit: VerticalLayout {
            alignment: start;

            pencil := TouchArea {
                width: 30px;
                height: 30px;
                clicked => { root.editing = true; }

                Rectangle {
                    background: pencil.has-hover ? AppTheme.gold : AppTheme.bg-panel-alt;
                    border-radius: AppTheme.radius-circle;

                    Text {
                        text: "✎";
                        color: pencil.has-hover ? AppTheme.text-ink : AppTheme.gold;
                        font-size: 14px;
                    }
                }
            }
        }
    }

    if root.editing && !root.multiline: HorizontalLayout {
        spacing: 8px;

        line-input := LineEdit {
            text: root.value;
            font-size: root.font-size;
            horizontal-stretch: 1;
            accepted(text) => { root.commit(text); }
            init => { self.focus(); }
        }
        IconButton {
            glyph: "✓";
            primary: true;
            clicked => { root.commit(line-input.text); }
        }
        IconButton {
            glyph: "✕";
            clicked => { root.editing = false; }
        }
    }

    if root.editing && root.multiline: HorizontalLayout {
        spacing: 8px;

        area-input := TextEdit {
            text: root.value;
            wrap: word-wrap;
            font-size: root.font-size;
            min-height: 120px;
            horizontal-stretch: 1;
            init => { self.focus(); }
        }
        VerticalLayout {
            alignment: start;
            spacing: 6px;

            IconButton {
                glyph: "✓";
                primary: true;
                clicked => { root.commit(area-input.text); }
            }
            IconButton {
                glyph: "✕";
                clicked => { root.editing = false; }
            }
        }
    }
}
