import { LineEdit } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { AdventureDraftCreationPopup } from "popup/adventure_draft_popup.slint";

export struct AdventureSummaryView {
    id: string,
    title: string,
    description: string,
    status: string
}

// The main page's data in, and its events out. Rust talks to this directly.
export global MainGlobals {
    in property <[AdventureSummaryView]> adventures-summary;
    callback adventure-selected(string);
    callback draft-adventure-selected(string);
    // Returns the new draft's id, or an empty string when it could not be created.
    callback create-adventure(string, string) -> string;
}
export component MainPage inherits Rectangle {
    in property <[AdventureSummaryView]> adventures-summary: MainGlobals.adventures-summary;

    property <bool> show-draft: false;

    background: AppTheme.bg-deepest;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Choose your adventure";
            color: AppTheme.gold;
            font-family: AppTheme.font-brand;
            font-size: AppTheme.font-title;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            new-draft-area := TouchArea {
                width: new-draft-label.preferred-width + 40px;
                height: 40px;
                clicked => { root.show-draft = true; }

                Rectangle {
                    background: parent.has-hover ? AppTheme.gold-bright : AppTheme.gold;
                    border-radius: AppTheme.radius-pill;

                    new-draft-label := Text {
                        text: "Create Adventure";
                        color: AppTheme.text-ink;
                        font-family: AppTheme.font-brand;
                        font-size: AppTheme.font-label;
                    }
                }
            }
        }

        if root.adventures-summary.length == 0: Text {
            text: "No adventures yet.";
            color: AppTheme.text-muted;
            font-family: AppTheme.font-body;
            horizontal-alignment: center;
        }

        for adventure-summary in root.adventures-summary: TouchArea {
            height: 72px;
            clicked => {
                if (adventure-summary.status == "draft") {
                    MainGlobals.draft-adventure-selected(adventure-summary.id);
                } else {
                    MainGlobals.adventure-selected(adventure-summary.id);
                }
            }

            Rectangle {
                background: parent.has-hover ? AppTheme.bg-panel-alt : AppTheme.bg-panel;
                border-radius: AppTheme.radius-card;
                border-width: 1px;
                border-color: AppTheme.bronze;

                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    Text {
                        text: adventure-summary.title;
                        color: AppTheme.text-light;
                        font-family: AppTheme.font-display;
                        font-size: AppTheme.font-card-title;
                    }

                    Text {
                        text: adventure-summary.description;
                        color: AppTheme.text-muted;
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-label;
                        wrap: word-wrap;
                    }

                    Text {
                        text: adventure-summary.status;
                        font-family: AppTheme.font-brand;
                        font-size: AppTheme.font-tiny;
                    }
                }
            }
        }
    }

    // Modal overlay: fills the whole page and sits above everything else.
    if root.show-draft: AdventureDraftCreationPopup {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        submit(title, headline) => {
            let new-adventure-id = MainGlobals.create-adventure(title, headline);
            if (new-adventure-id != "") {
                MainGlobals.draft-adventure-selected(new-adventure-id);
            }
        }
        dismiss => { root.show-draft = false; }
    }
}
